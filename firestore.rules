rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------
    // 1. GLOBAL HELPERS
    // ---------------------------------------------------------
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ---------------------------------------------------------
    // 2. VALIDATION HELPERS
    // ---------------------------------------------------------

    function isValidUserStats(data) {
      return data.keys().hasAll(['points', 'streak', 'completedDays', 'rank', 'unlockedBadges', 'xpToNextLevel']) &&
             data.points is number && data.points >= 0 &&
             data.streak is number && data.streak >= 0 &&
             data.completedDays is list &&
             data.rank is string &&
             data.unlockedBadges is list &&
             data.xpToNextLevel is number;
    }

    function isValidReadingProgress(data) {
      return data.keys().hasAll(['userId', 'book', 'chapter', 'completedAt']) &&
             data.userId == request.auth.uid &&
             data.book is string &&
             data.chapter is number;
    }

    function isValidSavedNote(data) {
      return data.keys().hasAll(['userId', 'reference', 'content', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.reference is string &&
             data.content is string;
    }

    // ---------------------------------------------------------
    // 3. MASTER GATE & DEFAULT DENY
    // ---------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }

    // Test doc for connection check (read-only for authenticated sessions)
    match /test/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---------------------------------------------------------
    // 4. COLLECTION RULES
    // ---------------------------------------------------------

    // User Profile and Stats (Read, Create, Update)
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserStats(incoming());
      allow update: if isOwner(userId) && isValidUserStats(incoming());
      allow delete: if isOwner(userId);
    }

    // Reading Progress Tracking (CRUD)
    match /progress/{userId}/completed/{progressId} {
      allow list, get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidReadingProgress(incoming());
      allow update: if isOwner(userId) && isValidReadingProgress(incoming());
      allow delete: if isOwner(userId);
    }

    // User Notes and Journal (Full CRUD)
    match /notes/{userId}/userNotes/{noteId} {
      allow list, get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidSavedNote(incoming());
      allow update: if isOwner(userId) && isValidSavedNote(incoming()) && incoming().userId == existing().userId;
      allow delete: if isOwner(userId);
    }
  }
}
